APP_NAME='SIZU'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:7998

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=saiz
DB_USERNAME=saiz
DB_PASSWORD=saiz

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=database

MAIL_DRIVER=log
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=example@example.test
MAIL_FROM_NAME="災図 開発環境"
MAIL_BCC_DEFAULT=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SSL_USE=false
MY_DECAY_MINUTES=10
MY_MAX_ATTEMPTS=5
DEV_ADMIN_PASSWORD=
WORDPRESS_URL=""
WORDPRESS_USER=""
WORDPRESS_APP_PASSWORD=""
WORDPRESS_CATEGORY_ID=
ONLINE_SIGNUP_ENABLED=false
PUBLIC_SUPPORT_STATUS_ENABLED=false
DISASTER_LLM_BASE_URL=https://api.openai.com/v1
DISASTER_LLM_API_KEY=
DISASTER_LLM_MODEL=gpt-4o-mini
DISASTER_LLM_TIMEOUT=120
DISASTER_LLM_RETRIES=2
DISASTER_SOURCE_DISK=local
DISASTER_LLM_SESSION_HEADER=x-opencode-session
DISASTER_LLM_SESSION_ID=saiz-disaster-intelligence
# 道路・仮置場の状態確認: 同じ記載へのAI再判定を省く期間（秒）と、AIへ送る抜粋の上限文字数
DISASTER_STATUS_CHECK_CACHE_TTL=604800
DISASTER_STATUS_CHECK_MAX_CHARS=40000

# 災害情報の自動収集ポリシー
DISASTER_CRAWLER_ENFORCE_ALLOWLIST=true
DISASTER_CRAWLER_RESOLVE_DNS=true
DISASTER_CRAWLER_RESPECT_ROBOTS=true
DISASTER_CRAWLER_ALLOW_HTTP=true
DISASTER_CRAWLER_USER_AGENT="SaizBot/1.0 (disaster information research)"
DISASTER_CRAWLER_CONTACT=
DISASTER_CRAWLER_MIN_INTERVAL_MS=1000
DISASTER_CRAWLER_MAX_REDIRECTS=3
DISASTER_CRAWLER_MAX_RESPONSE_BYTES=20971520
DISASTER_CRAWLER_CONNECT_TIMEOUT=10
DISASTER_CRAWLER_TIMEOUT=60

# LLM送信前の個人情報マスキング
DISASTER_REDACT_PII=true
DISASTER_REDACT_STRICT=false
DISASTER_REDACT_NER=false
DISASTER_REDACT_NER_PYTHON=/usr/bin/python3
DISASTER_REDACT_NER_SCRIPT=
DISASTER_REDACT_NER_TIMEOUT=60
